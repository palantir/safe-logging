# dependency-upgrader:OFF
# Don't want to impose 2.3.4 on downstream consumers as this triggers a baseline bug: https://github.com/palantir/gradle-baseline/issues/1113
com.google.errorprone:error_prone_annotations = 2.3.3

# Don't automatically force everything to upgrade slf4j
org.slf4j:slf4j-api = 1.7.31
# dependency-upgrader:ON
